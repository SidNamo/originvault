# PostgreSQL 데이터베이스 이름입니다. 최초 배포 후에는 변경하지 않습니다.
POSTGRES_DB=originvault
# backend 컨테이너만 사용하는 PostgreSQL 로그인 이름입니다. 최초 배포 후에는 변경하지 않습니다.
POSTGRES_USER=originvault
# PostgreSQL 비밀번호입니다. 신규 설치에서는 긴 임의 값을 사용합니다.
POSTGRES_PASSWORD=
# backend가 사용할 PostgreSQL connection string입니다. POSTGRES 설정과 일치시킵니다.
DATABASE_URL=

# 로그인 세션 JWT 서명 키입니다. `openssl rand -hex 32`로 생성합니다.
JWT_SECRET=
# 공개 공유 링크 서명 키입니다. JWT_SECRET과 다른 `openssl rand -hex 32` 값을 사용합니다.
SHARE_SECRET=
# 이전 share/JWT key로 서명된 공개 링크를 유지할 때를 제외하고 비워 둡니다.
LEGACY_SHARE_SECRET=

# 브라우저에서 접속할 정확한 origin입니다. scheme, host, port를 모두 포함합니다.
PUBLIC_URL=
# backend process bind 주소와 port입니다.
BACKEND_BIND_ADDRESS=
BACKEND_PORT=
# backend container 내부 healthcheck 대상 host입니다.
BACKEND_HEALTHCHECK_HOST=
# frontend reverse proxy가 사용할 backend origin입니다.
BACKEND_UPSTREAM=
# frontend host bind 주소와 port입니다.
FRONTEND_BIND_ADDRESS=
FRONTEND_PORT=

# 파일 하나당 허용할 최대 업로드 byte입니다. 10737418240은 10 GiB입니다.
MAX_UPLOAD_BYTES=10737418240
# 새 사용자 기본 저장 quota byte입니다. 10737418240은 10 GiB입니다.
DEFAULT_STORAGE_QUOTA_BYTES=10737418240
# 서버 로그 상세도입니다. 운영은 info를 사용하고, 문제 조사 때만 debug 또는 trace를 사용합니다.
LOG_LEVEL=info
# 보관할 UTC 일별 로그 파일 수입니다. 양의 정수를 입력합니다.
LOG_RETENTION_DAYS=7
